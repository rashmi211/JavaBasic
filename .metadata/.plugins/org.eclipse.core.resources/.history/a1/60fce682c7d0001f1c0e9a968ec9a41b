public class LargestOfThreeNumber {
	public static void main(String[] args) {
	int a=100,b=50,c=750;
	int largest = 0;
	
	if((a>b) && (a>c)){
		largest=a;
	}else if((b>a)&& (b>c))
	{
		largest=b;
	}else
	{
		largest=c;
	}
	System.out.println("Largest nuber will be " + largest);
}}
